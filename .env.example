# Server
HOST=127.0.0.1
PORT=3000
MITHRIL_API_URL=https://api.tryinstaclean.com
MITHRIL_TIMEOUT_MS=15000

# Comma-separated browser origins. Requests without Origin (typical MCP clients)
# are allowed. If Origin is present, it must match this list.
ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai

# Preferred for user-scoped ChatGPT/Claude/Cursor connections. The incoming
# Bearer token is forwarded to Mithril and Mithril enforces the user's roles.
AUTH_MODE=passthrough

# Service-agent mode. Uncomment all four lines together and use a dedicated
# active Instaclean admin actor. Never commit real values.
# AUTH_MODE=service
# MCP_API_KEY=replace-me
# MITHRIL_DIRECT_TOKEN=replace-me
# MITHRIL_ACTOR_USER_ID=00000000-0000-0000-0000-000000000000
